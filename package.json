{
  "name": "aethera-realm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node serve.mjs",
    "check": "node --check dist/js/app.js && node --check dist/js/pages.js && node --check dist/js/components.js && node --check dist/js/data.js && node --check dist/js/config.js",
    "dev:test": "node scripts/development.mjs",
    "account:create": "node scripts/accounts.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "test:demo": "node scripts/build-demo.mjs && node --test demo/demo.test.mjs",
    "preview:demo": "npm run build:demo && node scripts/preview-demo.mjs"
  }
}
